# KisanMitra AI Backend — Docker Build Ignore
# Prevents secrets and dev artifacts from leaking into the Docker image

# Secrets (injected via env vars at runtime on HF Spaces)
firebase-sa.json
*.json.json
.env
.env.example

# Dev artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
chroma_db/
*.egg-info/

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Tests (not needed in production image)
tests/

# Dev test scripts
test_*.py

# Documentation (except start.sh which is needed)
README.md

# Backup models
backup_original_models/
