# ==============================================================================
# DigiKisan Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# --- OpenRouter AI (REQUIRED for chatbot) ---
# Get your free API key at: https://openrouter.ai/keys (no credit card needed)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Default model (100% free): google/gemma-4-31b-it:free
# Alternatives: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen3-coder:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- MongoDB (REQUIRED) ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DBNAME=digikisan

# --- JWT Authentication ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=INSECURE-DEV-ONLY-CHANGE-IN-PRODUCTION

# --- Sarvam AI (Voice/Translation — Optional) ---
# Get API key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# --- data.gov.in (Market Prices — Optional but Recommended) ---
# Get free API key at: https://data.gov.in/
# Enables the fastest price data source (direct REST API)
DATA_GOV_API_KEY=

# --- Redis (Caching — Optional, defaults to in-memory) ---
REDIS_URL=redis://localhost:6379/0

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS Origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# --- Model Paths (relative to backend/ directory) ---
TEXT_CLASSIFIER_DIR=models/text_classifier
IMAGE_CLASSIFIER_CHECKPOINT=models/image_classifier/best_model.pth
IMAGE_CLASSIFIER_CLASSES=models/image_classifier/class_names.json

# --- Data Files (relative to backend/ directory) ---
COMMODITY_MAPPINGS_CSV=commodity_mappings.csv
DISTRICT_MAPPINGS_CSV=up_districts.csv
